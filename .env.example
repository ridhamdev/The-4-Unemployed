# Backend API Configuration
API_HOST=127.0.0.1
API_PORT=8000
ENVIRONMENT=production

# Database Configuration (Defaults to SQLite in backend/database/app.db)
DATABASE_URL=sqlite:///./backend/database/app.db

# Frontend Configuration
VITE_API_URL=http://127.0.0.1:8000/api
PORT=5173

# Optional: Google Earth Engine API (if using live cloud satellite extraction)
# GEE_SERVICE_ACCOUNT=your-service-account@project.iam.gserviceaccount.com
# GEE_PRIVATE_KEY_PATH=/path/to/private-key.json
